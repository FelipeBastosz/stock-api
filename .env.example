PROJECT_NAME="Variedades - API de Controle de Estoque"
VERSION="1.0.0"
ENV="development"
LOG_LEVEL="INFO"

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=estoque_db

DATABASE_URL=postgresql+asyncpg://admin:admin_password@localhost:5432/estoque_db
DATABASE_ECHO=false

# Autenticação e Segurança (JWT)
JWT_SECRET_KEY="secret-token-key-for-stock-api-development-use"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

